{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nulightjens.github.io/ArcheAge-PlayerBots/schemas/player-route-graph-v1.schema.json",
  "title": "Merged PlayerBots route graph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "graphId", "generatedUtc", "merge", "sourceRoutes", "nodes", "edges"],
  "properties": {
    "schema": { "const": "playerbots-route-graph-v1" },
    "schemaVersion": { "const": 1 },
    "graphId": { "type": "string", "pattern": "^[a-f0-9]{16}$" },
    "generatedUtc": { "type": "string", "format": "date-time" },
    "merge": { "type": "object" },
    "sourceRoutes": { "type": "array", "minItems": 1 },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "worldId", "instanceId", "x", "y", "z", "confidence", "supportCount", "spreadMeters", "zoneVotes", "observations"],
        "properties": {
          "id": { "type": "string", "pattern": "^n[0-9]{6}$" },
          "worldId": { "type": "integer", "minimum": 0 },
          "instanceId": { "type": "integer", "minimum": 0 },
          "x": { "type": "number" },
          "y": { "type": "number" },
          "z": { "type": "number" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "supportCount": { "type": "integer", "minimum": 1 },
          "spreadMeters": { "type": "number", "minimum": 0 },
          "zoneVotes": { "type": "object" },
          "observations": { "type": "array", "minItems": 1 }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "a", "b", "confidence", "supportCount", "recordingIds", "pathTypeVotes", "directionVotes"],
        "properties": {
          "id": { "type": "string", "pattern": "^e[0-9]{6}$" },
          "a": { "type": "string", "pattern": "^n[0-9]{6}$" },
          "b": { "type": "string", "pattern": "^n[0-9]{6}$" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "supportCount": { "type": "integer", "minimum": 1 },
          "recordingIds": { "type": "array", "minItems": 1, "uniqueItems": true },
          "pathTypeVotes": { "type": "object" },
          "directionVotes": { "type": "object" }
        }
      }
    }
  }
}
