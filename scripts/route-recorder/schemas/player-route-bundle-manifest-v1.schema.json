{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nulightjens.github.io/ArcheAge-PlayerBots/schemas/player-route-bundle-manifest-v1.schema.json",
  "title": "PlayerBots route bundle manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schemaVersion", "bundleId", "createdUtc", "files", "provenance", "privacy"],
  "properties": {
    "schema": { "const": "playerbots-route-bundle-manifest-v1" },
    "schemaVersion": { "const": 1 },
    "bundleId": { "type": "string", "format": "uuid" },
    "createdUtc": { "type": "string", "format": "date-time" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "sha256", "bytes"],
        "properties": {
          "path": { "type": "string", "pattern": "^[^/\\\\]+$" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "bytes": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "provenance": { "type": "object" },
    "privacy": {
      "type": "object",
      "required": ["containsCredentials", "containsServerLogs", "containsRawRecording"],
      "properties": {
        "containsCredentials": { "const": false },
        "containsServerLogs": { "const": false },
        "containsRawRecording": { "const": false }
      }
    }
  }
}
