{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Explicit player route network v1",
  "type": "object",
  "required": [
    "schema",
    "schemaVersion",
    "networkId",
    "name",
    "generatedUtc",
    "coordinateSystem",
    "gameVersion",
    "versionDeclaration",
    "junctionPolicy",
    "nodes",
    "edges",
    "breaks",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "playerbots-route-network-v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "networkId": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "gameVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "coordinateSystem": {
      "const": "aaemu-server-world-xyz-metres"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "explicit",
          "worldId",
          "instanceId",
          "zoneId",
          "x",
          "y",
          "z",
          "sampleSequences"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^n[0-9]{6}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "explicit": {
            "type": "boolean"
          },
          "worldId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "instanceId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "zoneId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "z": {
            "type": "number"
          },
          "sampleSequences": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "worldId",
          "instanceId",
          "direction",
          "points",
          "evidence",
          "reverseVerified"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^e[0-9]{6}$"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "worldId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "instanceId": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "direction": {
            "const": "from-to"
          },
          "points": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "x",
                "y",
                "z"
              ],
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                },
                "z": {
                  "type": "number"
                }
              }
            }
          },
          "evidence": {
            "const": "observed-traversal"
          },
          "reverseVerified": {
            "const": false
          }
        }
      }
    },
    "breaks": {
      "type": "array"
    },
    "provenance": {
      "type": "object"
    }
  }
}
